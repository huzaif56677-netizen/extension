{
  "manifest_version": 3,
  "name": "Browser Pet",
  "version": "1.1.0",
  "description": "A small animated 2D companion pet that lives inside your browser tabs when summoned.",
  "permissions": [
    "storage",
    "activeTab",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Pet"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/constants.js",
        "src/ui-components.js",
        "src/pdf-export.js",
        "src/storage.js",
        "src/notes-ui.js",
        "src/settings-ui.js",
        "src/pet.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "assets/Sprites/*",
        "assets/Sprites/*/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
